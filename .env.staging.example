# Copy to .env.staging.local, using ONLY a separate staging Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=your-getcyb-staging-project
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=your-getcyb-staging-project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-getcyb-staging-project.firebasestorage.app
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Public sandbox client ID only. Never put a secret in VITE_ variables.
VITE_PAYPAL_CLIENT_ID=
